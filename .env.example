# Chemin hôte vers les credentials Claude (abonnement) — monté read-only dans le conteneur
CLAUDE_CREDENTIALS=C:\Users\<toi>\.claude\.credentials.json

# Parallélisme par défaut (sémaphore)
USINE_PARALLEL=3

# Modèle par agent (alias CLI : sonnet / opus / haiku, ou ID complet)
USINE_MODEL_DISCOVER=sonnet
USINE_MODEL_PRODUCT=sonnet
USINE_MODEL_DEV=sonnet
USINE_MODEL_FIX=sonnet
USINE_MODEL_BUSINESS=haiku

# Plafond de coût équiv. API par run en $ (0 = désactivé)
USINE_MAX_COST_PER_RUN=0
